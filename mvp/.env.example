# Copie para .env e ajuste. O .env nunca deve ir para o git.

# Token que o SDK do agente envia (Authorization: Bearer ...). Gere um valor longo e aleatório.
AGENT_TOKEN=

# Opcional: exige o cabeçalho x-panel-token no painel. Obrigatório se HOST não for localhost.
PANEL_TOKEN=

# Nome no cumprimento do ecrã Início (Olá, Nome). Também podes gravar no browser (nectrae.userName).
PANEL_NAME=

HOST=127.0.0.1
PORT=8787

# devnet (testes) ou mainnet
SOLANA_NETWORK=devnet

# Em branco usa o RPC público da rede escolhida. Para produção, use um provedor (Helius, Triton, QuickNode).
# A chave do provedor fica só aqui, no servidor; o painel mostra só os 4 últimos caracteres.
SOLANA_RPC_URL=

# finalized (mais seguro) ou confirmed (mais rápido)
SOLANA_COMMITMENT=finalized

# Em branco usa o USDC oficial da rede escolhida.
USDC_MINT=

# sepolia (testes) ou mainnet. Em branco usa o RPC público.
BASE_NETWORK=sepolia
BASE_RPC_URL=

# Em branco usa o USDC oficial da rede escolhida.
BASE_USDC=

# De quanto em quanto tempo a validação roda sozinha (0 desliga).
VALIDATE_EVERY_SECONDS=60

DB_PATH=

# Agente vivo (botão Ligar no painel, ou npm run agent noutro terminal).
# A chave fica só neste arquivo; o servidor dispara o runner noutro processo e nunca importa pay.mjs.
# LIVE_AGENT=nansen
# LIVE_NETWORK=solana
# LIVE_AMOUNT=0.01
# LIVE_APPROVAL_AMOUNT=0.04
# LIVE_EVERY=12
# Carteira que recebe o USDC de teste (não use Tokenkeg / 0x111…). Acrescente o mesmo endereço em Admin.
# LIVE_DESTINATION=
# Keypair da Phantom em Devnet (JSON de 64 números ou base58). Nunca cole isto no painel.
# O endereço público desta chave precisa estar em Proteção para a validação marcar Conferido.
# AGENT_SOLANA_SECRET=
