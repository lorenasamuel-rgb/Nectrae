# Copy to .env and edit. .env must never be committed.

# Token the agent SDK sends (Authorization: Bearer ...). Generate a long random value.
AGENT_TOKEN=

# Automatic payer. The key file is data/keys/<agent>.json (gitignored). The panel never reads it.
# The public key in the file must match the Solana address in Protection.
# AGENT_AMOUNT=0.01
# AGENT_EVERY_SECONDS=20
# AGENT_MAX=0 means keep paying until the cap blocks the call.

# Optional: requires the x-panel-token header on the panel. Required if HOST is not localhost.
PANEL_TOKEN=

HOST=127.0.0.1
PORT=8787

# devnet (tests) or mainnet
SOLANA_NETWORK=devnet

# Blank uses the public RPC for the chosen network. For production, use a provider (Helius, Triton, QuickNode).
# The provider key stays only here, on the server; the panel shows at most the last 4 characters.
SOLANA_RPC_URL=

# finalized (safer) or confirmed (faster)
SOLANA_COMMITMENT=finalized

# Blank uses the official USDC mint for the chosen network.
USDC_MINT=

# sepolia (tests) or mainnet. Blank uses the public RPC.
BASE_NETWORK=sepolia
BASE_RPC_URL=

# Blank uses the official USDC contract for the chosen network.
BASE_USDC=

# How often validation runs on its own (0 turns it off).
VALIDATE_EVERY_SECONDS=60

# Optional. The panel watcher calls Grok for one sentence about the caps.
# The key stays only here. Without it, the face still animates and speaks a local line.
XAI_API_KEY=
XAI_MODEL=grok-4

DB_PATH=
